# ========================================================
# NGODING YUK - ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env and update values for your environment

# MongoDB Connection String
# LOCAL:      mongodb://localhost:27017/ngoding-yuk
# ATLAS:      mongodb+srv://user:pass@cluster.mongodb.net/ngoding-yuk
MONGODB_URI=mongodb://localhost:27017/ngoding-yuk

# Server Port (default: 3000)
PORT=3000

# JWT Secret Key (MUST CHANGE IN PRODUCTION!)
# Generate random key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-random-string-in-production

# Environment Type
# Values: development | production | test
NODE_ENV=development

# CORS Configuration (comma-separated list of allowed origins)
# LOCAL:      http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# PRODUCTION: https://ngoding-yuk.com,https://www.ngoding-yuk.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5500

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# Database Settings
DB_NAME=ngoding-yuk
DB_COLLECTION_USERS=users
DB_COLLECTION_COURSES=courses
DB_COLLECTION_TOPICS=topics
DB_COLLECTION_FORUM=forum
DB_COLLECTION_CERTIFICATES=certificates

# Logging (optional)
LOG_LEVEL=info

# Session Configuration (optional)
SESSION_SECRET=change-this-session-secret-in-production
